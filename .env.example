# Option A (recommended): OAuth2 app from https://cloud.ouraring.com/oauth/applications
# Set the redirect URI there to http://localhost:3077/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Option B: a token you already have (personal access tokens are deprecated by Oura,
# but if you hold a valid bearer token you can drop it here)
OURA_TOKEN=

# Optional
PORT=3077
# Force demo data even when credentials exist
OURA_DEMO=
